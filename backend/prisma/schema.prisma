// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String
  email                String    @unique
  senha                String
  cargo                Cargo     @default(USUARIO)
  dataDeCriacao        DateTime  @default(now())
  ChamadosSolicitados  Chamado[] @relation("ChamadosSolicitados")
  ChamadosAtendimentos Chamado[] @relation("ChamadosAtendimentos")
}

enum Cargo {
  USUARIO
  TECNICO
  ADMIN
}

model Chamado {
  id               Int      @id @default(autoincrement())
  usuarioId        Int
  usuario          Usuario  @relation("ChamadosSolicitados", fields: [usuarioId], references: [id])
  tecnicoId        Int?
  tecnico          Usuario? @relation("ChamadosAtendimentos", fields: [tecnicoId], references: [id])
  titulo           String
  descricao        String
  tipoAjuda        String
  status           String   @default("ABERTO")
  descricaoSolucao String?
  dataDeCriacao    DateTime @default(now())
}
